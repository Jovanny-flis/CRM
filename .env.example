# Host del servidor MySQL o MariaDB donde reside la base del CRM.
DB_HOST=localhost
# Usuario de conexion a la base de datos.
DB_USER=crm_db_user
# Contrasena del usuario de base de datos (sustituir por la de tu entorno).
DB_PASSWORD=your_database_password
# Nombre del esquema o base de datos del CRM.
DB_NAME=db_name
# Puerto TCP en el que escucha la API Express.
# Para prueba local de integración con GROUER (esa API ya usa 3000), usar PORT=3001 en CRM/.env.
PORT=3000
# Hostname del servidor SMTP para el envio de correos (recuperacion de contrasena).
EMAIL_HOST=smtp.example.com
# Puerto SMTP. Usar 465 para SSL (secure: true) o 587 para STARTTLS (secure: false). El transporter actual en index.js usa secure: true — se recomienda 465.
EMAIL_PORT=465
# Direccion de correo autenticada en el servidor SMTP (remitente).
EMAIL_USER=noreply@example.com
# Contrasena o contrasena de aplicacion del buzon SMTP anterior.
EMAIL_PASS=your_smtp_password
# NOTA: Esta variable debe configurarse en frontend/.env, no en este archivo. Vite solo lee variables desde el directorio del frontend.
FRONTEND_BASE_URL=http://localhost:5173
# Origenes permitidos para CORS.
CORS_ORIGINS=http://localhost:5173

# --- Integración GROUER (alta automática de prospectos) ---
# Valores reales solo en .env local o VPS; nunca IDs/tokens de prod en git.
# Id numérico de empresas.id con nombre_comercial = GROUER (lo imprime la semilla local).
GROUER_EMPRESA_ID=
# Secreto compartido CRM ↔ API GROUER (mismo valor en ambos .env). Vacío = inbound y proxy PDF responden 503.
GROUER_CRM_SHARED_TOKEN=
# URL de la API GROUER (proxy PDF). Local: http://127.0.0.1:3000
# Prod (red Docker grouer-crm): http://api:3000
# Fallback HTTPS: https://api.grouer.com.mx — el CRM no llama a riesgos:8000.
GROUER_API_URL=http://127.0.0.1:3000
# UID de Firebase Auth del usuario técnico «Sistema GROUER» (el humano lo crea en Auth y lo pega).
GROUER_ROBOT_FIREBASE_UID=
